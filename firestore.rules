rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isLandlord() {
      return isSignedIn() && getUserData().role == 'LANDLORD';
    }

    function isTenant() {
      return isSignedIn() && getUserData().role == 'TENANT';
    }

    // --- COLLECTION RULES ---

    // User profiles: User can edit self. Landlord can edit/delete tenants for administrative cleanup.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if (request.auth.uid == userId) || isLandlord();
    }

    // Boarding Houses
    match /boardingHouses/{houseId} {
      allow read: if isSignedIn();
      allow write: if isLandlord() && (resource == null || resource.data.landlordId == request.auth.uid);
    }

    // Rooms
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isLandlord();
    }

    // Room Requests
    match /roomRequests/{requestId} {
      allow read: if isSignedIn() && (isLandlord() || resource.data.tenantId == request.auth.uid);
      allow create: if isTenant();
      allow update, delete: if isLandlord() || (isSignedIn() && resource.data.tenantId == request.auth.uid);
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (isLandlord() || (resource != null && resource.data.tenantId == request.auth.uid));
      allow create: if isSignedIn();
      allow update, delete: if isLandlord();
    }

    // Receipts
    match /receipts/{receiptId} {
      allow read: if isSignedIn() && (isLandlord() || (resource != null && resource.data.tenantId == request.auth.uid));
      allow delete: if isLandlord();
    }

    // Rent Periods
    match /rentPeriods/{periodId} {
      allow read: if isSignedIn() && (isLandlord() || (resource != null && resource.data.tenantId == request.auth.uid));
      allow write, delete: if isLandlord();
    }

    // Complaints
    match /complaints/{complaintId} {
      allow read: if isSignedIn() && (isLandlord() || (resource != null && resource.data.tenantId == request.auth.uid));
      allow create: if isTenant();
      allow update, delete: if isLandlord() || (isSignedIn() && resource.data.tenantId == request.auth.uid);
    }

    // Conversations & Messages
    match /conversations/{convId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow create: if isSignedIn();
      allow update, delete: if isLandlord() || (isSignedIn() && request.auth.uid in resource.data.participants);

      match /messages/{msgId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants);
        allow create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants);
        allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.senderId || isLandlord());
      }
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (isLandlord() || (resource != null && resource.data.tenantId == request.auth.uid));
      allow write, delete: if isLandlord();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isLandlord();
      allow create: if isSignedIn();
    }
  }
}
