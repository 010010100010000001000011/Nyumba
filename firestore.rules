rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function housePath(houseId) {
      return /databases/$(database)/documents/boardingHouses/$(houseId);
    }

    function myData() {
      return get(userPath(request.auth.uid)).data;
    }

    function isLandlord() {
      return isSignedIn() && exists(userPath(request.auth.uid)) && myData().get('role', '') == 'LANDLORD';
    }

    // The caller is the landlord who owns this boarding house.
    function ownsHouse(houseId) {
      return isSignedIn()
        && houseId is string && houseId != ''
        && exists(housePath(houseId))
        && get(housePath(houseId)).data.landlordId == request.auth.uid;
    }

    // The caller is the landlord of the house this tenant currently lives in.
    function landlordOfTenant(tenantId) {
      return isSignedIn()
        && tenantId is string && tenantId != ''
        && exists(userPath(tenantId))
        && ownsHouse(get(userPath(tenantId)).data.get('boardingHouseId', null));
    }

    // The caller is the tenant themselves, or their landlord (by house or by tenancy).
    function tenantOrLandlord(data) {
      return (isSignedIn() && data.get('tenantId', null) == request.auth.uid)
        || ownsHouse(data.get('boardingHouseId', null))
        || landlordOfTenant(data.get('tenantId', null));
    }

    // A tenant writing a record for themselves in the house they live in.
    function isOwnTenantRecord(data) {
      return isSignedIn()
        && data.tenantId == request.auth.uid
        && data.boardingHouseId == myData().get('boardingHouseId', null);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function unchanged(key) {
      return request.resource.data.get(key, null) == resource.data.get(key, null);
    }

    // Fields only a landlord may set on a tenant's profile.
    function tenancyKeys() {
      return ['currentRoomId', 'boardingHouseId', 'landlordId', 'monthlyRent', 'paymentDueDay', 'isActive', 'active'];
    }

    // --- COLLECTION RULES ---

    // User profiles
    match /users/{userId} {
      // Self, any landlord profile (tenants see who they rent from), or a tenant's own landlord.
      allow read: if isSelf(userId)
        || (isSignedIn() && resource.data.get('role', '') == 'LANDLORD')
        || ownsHouse(resource.data.get('boardingHouseId', null));

      allow create: if isSelf(userId)
        && request.resource.data.role in ['TENANT', 'LANDLORD']
        && request.resource.data.get('boardingHouseId', null) == null
        && request.resource.data.get('currentRoomId', null) == null
        && request.resource.data.get('landlordId', null) == null
        && request.resource.data.get('monthlyRent', 0) == 0;

      // Users edit their own profile but cannot change role or tenancy fields.
      // Landlords may change tenancy fields only for tenants entering or already in their house.
      allow update: if (isSelf(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'].concat(tenancyKeys())))
        || ((ownsHouse(resource.data.get('boardingHouseId', null))
             || ownsHouse(request.resource.data.get('boardingHouseId', null)))
          && unchanged('role')
          && changedOnly(tenancyKeys()));

      allow delete: if isSelf(userId) || ownsHouse(resource.data.get('boardingHouseId', null));
    }

    // Boarding Houses (publicly browsable by signed-in users for discovery)
    match /boardingHouses/{houseId} {
      allow read: if isSignedIn();
      allow create: if isLandlord() && request.resource.data.landlordId == request.auth.uid;
      allow update: if ownsHouse(houseId) && request.resource.data.landlordId == request.auth.uid;
      allow delete: if ownsHouse(houseId);
    }

    function requestPath(requestId) {
      return /databases/$(database)/documents/roomRequests/$(requestId);
    }

    function isTenantHoldChange(roomId) {
      let reqId = request.resource.data.get('lastRequestId', '');
      let after = getAfter(requestPath(reqId)).data;
      return isSignedIn()
        && reqId is string && reqId != ''
        && changedOnly(['heldCount', 'updatedAt', 'lastRequestId'])
        && after.tenantId == request.auth.uid
        && after.roomId == roomId
        && (
          // placing a hold: the request is new and HOLDING
          (request.resource.data.heldCount == resource.data.heldCount + 1
            && !exists(requestPath(reqId)) && after.status == 'HOLDING')
          // releasing a hold: the request goes HOLDING -> EXPIRED
          || (request.resource.data.heldCount == resource.data.heldCount - 1
            && get(requestPath(reqId)).data.status == 'HOLDING' && after.status == 'EXPIRED')
        );
    }

    // Rooms
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if ownsHouse(request.resource.data.boardingHouseId);
      allow update: if (ownsHouse(resource.data.boardingHouseId) && unchanged('boardingHouseId'))
        // Tenants may move heldCount by one only together with their own hold request
        // (named in lastRequestId) being created or expired in the same transaction.
        || isTenantHoldChange(roomId);
      allow delete: if ownsHouse(resource.data.boardingHouseId);
    }

    // Room Requests
    match /roomRequests/{requestId} {
      allow read: if tenantOrLandlord(resource.data);
      // A HOLDING request must reserve its bed in the same transaction (room.lastRequestId == this id)
      allow create: if isSignedIn()
        && request.resource.data.tenantId == request.auth.uid
        && (request.resource.data.status == 'PENDING'
          || (request.resource.data.status == 'HOLDING'
            && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.get('lastRequestId', '') == requestId));
      allow update: if (ownsHouse(resource.data.boardingHouseId) && unchanged('boardingHouseId'))
        // Tenants may only expire their own lapsed holds.
        || (isSignedIn()
          && resource.data.tenantId == request.auth.uid
          && resource.data.status == 'HOLDING'
          && request.resource.data.status == 'EXPIRED'
          && changedOnly(['status', 'updatedAt']));
      allow delete: if ownsHouse(resource.data.boardingHouseId) || landlordOfTenant(resource.data.tenantId);
    }

    // Lipila payment intents: written only by Cloud Functions (functions/src/payments.ts).
    match /paymentIntents/{referenceId} {
      allow read: if isSignedIn() && resource.data.tenantId == request.auth.uid;
    }

    // Payments
    // Mobile-money payments are recorded server-side by Cloud Functions; landlords record cash.
    match /payments/{paymentId} {
      allow read: if tenantOrLandlord(resource.data);
      allow create: if ownsHouse(request.resource.data.boardingHouseId)
        && request.resource.data.paymentMethod == 'CASH';
      allow update: if ownsHouse(resource.data.boardingHouseId) && unchanged('boardingHouseId');
      allow delete: if ownsHouse(resource.data.boardingHouseId) || landlordOfTenant(resource.data.tenantId);
    }

    // Receipts
    match /receipts/{receiptId} {
      allow read: if tenantOrLandlord(resource.data);
      allow create: if ownsHouse(request.resource.data.boardingHouseId);
      allow delete: if ownsHouse(resource.data.boardingHouseId) || landlordOfTenant(resource.data.tenantId);
    }

    // Rent Periods
    match /rentPeriods/{periodId} {
      allow read: if tenantOrLandlord(resource.data);
      allow create: if ownsHouse(request.resource.data.boardingHouseId);
      // Tenants' reminder worker may only record sent reminders and flag a period OVERDUE.
      allow update: if (ownsHouse(resource.data.boardingHouseId) && unchanged('boardingHouseId'))
        || (isSignedIn()
          && resource.data.tenantId == request.auth.uid
          && changedOnly(['status', 'updatedAt', 'sentReminders'])
          && (unchanged('status') || request.resource.data.status == 'OVERDUE'));
      allow delete: if ownsHouse(resource.data.boardingHouseId) || landlordOfTenant(resource.data.tenantId);
    }

    // Complaints
    match /complaints/{complaintId} {
      allow read: if tenantOrLandlord(resource.data);
      allow create: if isOwnTenantRecord(request.resource.data);
      allow update: if ownsHouse(resource.data.boardingHouseId) && unchanged('boardingHouseId') && unchanged('tenantId');
      allow delete: if ownsHouse(resource.data.boardingHouseId) || landlordOfTenant(resource.data.tenantId);
    }

    // Conversations & Messages
    match /conversations/{convId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }

      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participants
        || resource.data.tenantId == request.auth.uid
        || resource.data.landlordId == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && (request.resource.data.tenantId == request.auth.uid || request.resource.data.landlordId == request.auth.uid)
        && request.resource.data.participants.hasAll([request.resource.data.tenantId, request.resource.data.landlordId]);
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && changedOnly(['lastMessage', 'lastMessageAt']);

      match /messages/{msgId} {
        allow read: if isParticipant();
        allow create: if isParticipant() && request.resource.data.senderId == request.auth.uid;
        allow update: if isParticipant() && changedOnly(['readAt', 'deletedForSender', 'deletedForReceiver']);
      }
    }

    // Collection-group access to messages (used when a landlord deletes a tenant's records).
    match /{path=**}/messages/{msgId} {
      allow read, delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid
        || resource.data.receiverId == request.auth.uid
        || landlordOfTenant(resource.data.senderId)
        || landlordOfTenant(resource.data.receiverId)
      );
    }

    // Notifications
    match /notifications/{notifId} {
      function isRecipient() {
        return isSignedIn() && (
          resource.data.get('tenantId', null) == request.auth.uid
          || resource.data.get('landlordId', null) == request.auth.uid
        );
      }

      allow read: if isRecipient() || landlordOfTenant(resource.data.get('tenantId', null));
      // Tenants notify landlords and vice versa from the client; move to Cloud Functions with push later.
      allow create: if isSignedIn();
      allow update: if isRecipient() && changedOnly(['isRead']);
      allow delete: if isRecipient() || landlordOfTenant(resource.data.get('tenantId', null));
    }

    // Audit Logs (append-only)
    match /auditLogs/{logId} {
      allow read: if ownsHouse(resource.data.get('boardingHouseId', null));
      allow create: if isSignedIn();
    }
  }
}
