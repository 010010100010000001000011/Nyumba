rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isLandlord() {
      return userDocExists() && ('role' in getUserData()) && getUserData().role == 'LANDLORD';
    }

    function isTenant() {
      return userDocExists() && ('role' in getUserData()) && getUserData().role == 'TENANT';
    }

    // --- COLLECTION RULES ---

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isLandlord());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isLandlord());
    }

    // Boarding Houses
    match /boardingHouses/{houseId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Rooms
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Room Requests
    match /roomRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        isLandlord() ||
        (resource != null && (resource.data.tenantId == request.auth.uid || resource.data.landlordId == request.auth.uid))
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Receipts
    match /receipts/{receiptId} {
      allow read: if isSignedIn() && (
        isLandlord() ||
        (resource != null && (resource.data.tenantId == request.auth.uid || resource.data.landlordId == request.auth.uid))
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Rent Periods
    match /rentPeriods/{periodId} {
      allow read: if isSignedIn() && (
        isLandlord() ||
        (resource != null && (resource.data.tenantId == request.auth.uid || resource.data.landlordId == request.auth.uid))
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Complaints
    match /complaints/{complaintId} {
      allow read: if isSignedIn() && (
        isLandlord() ||
        (resource != null && (resource.data.tenantId == request.auth.uid || resource.data.landlordId == request.auth.uid))
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Conversations & Messages
    match /conversations/{convId} {
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.participants ||
        resource.data.tenantId == request.auth.uid ||
        resource.data.landlordId == request.auth.uid ||
        isLandlord()
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();

      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn();
      }
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        isLandlord() ||
        (resource != null && (
          resource.data.tenantId == request.auth.uid ||
          resource.data.landlordId == request.auth.uid
        ))
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
  }
}
